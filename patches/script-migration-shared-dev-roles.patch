+// Synthetic development roles only. Existing role documents are never rewritten.
+const names = ['guest', 'beta_user'];
+function guard(db) {
+  if (process.env.CHART_INFRA_FIXTURE !== 'sean-offline-v1' || db.databaseName !== 'auth' ||
+      !process.env.MONGO_URI_AUTH?.includes('@mongo-0.mongo.chart-sean.svc.cluster.local:27017/')) {
+    throw new Error('This fixture is restricted to the registered chart-sean development database');
+  }
+}
+export default {
+  id: '20261001_001_shared_dev_roles',
+  description: 'Seed minimal synthetic shared development roles without touching existing records',
+  collections: ['roles'], query: {}, options: { runOnce: true },
+  async up(db) { guard(db); return null; },
+  async afterBatch(db) {
+    guard(db);
+    for (const name of names) {
+      await db.collection('roles').updateOne({ name }, { $setOnInsert: {
+        name, permissions: {}, types: [], BARS_LIMIT: 10000
+      } }, { upsert: true });
+    }
+    if (await db.collection('roles').countDocuments({ name: { $in: names } }) !== names.length)
+      throw new Error('Development role verification failed');
+    console.log('Synthetic development roles verified; no market-data permissions granted');
+  },
+  async verify(db) { guard(db); return true; }
+};
