#!/usr/bin/env python3
"""chart {mongo|sources|deps|apps|runtime|fixtures|sync} --help"""
import os
from pathlib import Path
import sys
commands = {name: name + '.py' for name in ('mongo', 'sources', 'deps', 'apps', 'runtime', 'fixtures', 'sync')}
if len(sys.argv) < 2 or sys.argv[1] not in commands:
    print(__doc__)
    sys.exit(0 if len(sys.argv) == 1 or sys.argv[1] in ('-h', '--help') else 2)
os.execv(sys.executable, [sys.executable, str(Path(__file__).resolve().parent / commands[sys.argv[1]]), *sys.argv[2:]])
